# Telegram bot token from @BotFather
BOT_TOKEN=

# Numeric Telegram user id allowed to use /admin, /broadcast, /leads and /reminders
ADMIN_USER_ID=

# Highlightly All Sports API key (sent as the x-rapidapi-key header)
HIGHLIGHTLY_API_KEY=

# Postgres connection string used on Railway.
# Leave empty for local development — the bot falls back to sqlite file paheli777.db
# postgresql://user:password@host:5432/railway
DATABASE_URL=

# Public brand website. Placeholder until the real Paheli777 URL is known.
BRAND_URL=https://example.com

# Optional
# APP_TIMEZONE=Asia/Kolkata
# REMINDER_LEAD_MINUTES=45
