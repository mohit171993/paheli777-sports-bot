# Telegram bot token from @BotFather
BOT_TOKEN=

# Numeric Telegram user id allowed to run /admin, /broadcast, /leads, /sync, /reminders
ADMIN_USER_ID=

# Paid Highlightly key. Sent as the x-rapidapi-key header.
HIGHLIGHTLY_API_KEY=

# Postgres connection string. On Railway this comes from the Postgres plugin.
# Leave it empty for local dev and the bot uses sqlite:///paheli777.db
DATABASE_URL=

# Public brand website. Placeholder until the real URL is known.
BRAND_URL=https://example.com

# Optional
# REMINDER_LEAD_MINUTES=45
# REMINDER_QUIET_HOURS=23-8
# NOTABLE_PER_SPORT=6
# SYNC_INTERVAL_SECONDS=300
